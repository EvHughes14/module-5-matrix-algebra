A <- matrix(1:100,  nrow = 10)
B <- matrix(1:1000, nrow = 10)

dim(A)
dim(B)

invA <- solve(A) #Throws an error because it is already at singuilarity of 0
detA <- det(A) # Runs fine to 0 because it is square
detA #Returns as 0

invB <- tryCatch(solve(B), error = function(e) e)
detB <- tryCatch(det(B),   error = function(e) e) #Willrun fine as this takes away the error as it is not a square 
detB #Will still run without error, however the output itself is an error warning that due to it not being sqaure, it will never be singular
